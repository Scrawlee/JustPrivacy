# Variables à définir dans Dokploy (Environment).
PUBLIC_URL=https://justprivacy.example      # URL publique exacte (origine WebAuthn, contrôle CSRF, cookies Secure)
POSTGRES_PASSWORD=change-me                 # openssl rand -hex 24
CAP_SECRET=                                 # secret de la clé de site Cap 5c7f97279d (pas l'ADMIN_KEY)
APP_SECRET=                                 # facultatif : clé de chiffrement des secrets OTP ; sinon /data/app.key est généré
# CAP_SITEVERIFY_URL=https://check.scrawlee.com/5c7f97279d/siteverify
# TRUST_PROXY_HOPS=1                        # nombre de proxys devant l'app (Traefik = 1)
